@TuneVault.API_HostAddress = http://localhost:5093
@testUserId = U002
@testSenderId = U001
@testMediaId = 11111111-1111-1111-1111-111111111111
@notificationId = {{createNotification.response.body.data}}

###############################################
# GIAI ĐOẠN 7 - REST API TESTS
###############################################

### 7.1.1 Media controller health check
GET {{TuneVault.API_HostAddress}}/api/media/health
Accept: application/json

### 7.1.2 Lấy metadata media (thay @testMediaId bằng ID thật trong DB)
GET {{TuneVault.API_HostAddress}}/api/media/{{testMediaId}}/metadata
Accept: application/json

### 7.1.3 Lấy thông tin media
GET {{TuneVault.API_HostAddress}}/api/media/{{testMediaId}}/info
Accept: application/json

### 7.1.4 Stream media (full file)
GET {{TuneVault.API_HostAddress}}/api/media/{{testMediaId}}/stream
Accept: */*

### 7.1.5 Stream media với Range header (206 Partial Content)
GET {{TuneVault.API_HostAddress}}/api/media/{{testMediaId}}/stream
Range: bytes=0-1023
Accept: */*

